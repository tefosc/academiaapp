  <script is:inline>
    (function () {
      var html = document.documentElement;
      var hasIO = 'IntersectionObserver' in window;

      /* ── Gauge: anima los arcos SVG al entrar en vista ── */
      var C = 2 * Math.PI * 80;
      function fillArcs(root) {
        root.querySelectorAll('.gauge-arc').forEach(function (arc) {
          var pct = parseFloat(arc.getAttribute('data-pct') || '0');
          arc.style.strokeDashoffset = String(C * (1 - pct / 100));
        });
      }
      var gaugeGrid = document.getElementById('gauge-grid');
      if (gaugeGrid) {
        if (hasIO) {
          var gaugeObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              fillArcs(entry.target);
              gaugeObs.unobserve(entry.target);
            });
          }, { threshold: 0.2 });
          gaugeObs.observe(gaugeGrid);
        } else {
          fillArcs(gaugeGrid);
        }
      }

      /* ── Scroll spy: ilumina el enlace de la sección visible ── */
      var navLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-links a'));
      if (hasIO) {
        var spyObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            navLinks.forEach(function (l) { l.classList.remove('active'); });
            var match = navLinks.filter(function (l) { return l.getAttribute('href') === '#' + entry.target.id; })[0];
            if (match) match.classList.add('active');
          });
        }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
        ['como', 'features', 'modulos'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) spyObs.observe(el);
        });
      }

      /* ── Entrada de secciones al hacer scroll ──
         Solo actúa si el <head> marcó <html class="js">; sin JS o con movimiento
         reducido nada se oculta y todo el contenido se ve desde el inicio. */
      var items = document.querySelectorAll('[data-reveal], [data-reveal-self]');
      if (hasIO && html.classList.contains('js')) {
        var revealObs = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('in');
            revealObs.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -15% 0px', threshold: 0.01 });
        items.forEach(function (el) { revealObs.observe(el); });
        window.addEventListener('beforeprint', function () {
          items.forEach(function (el) { el.classList.add('in'); });
        });
      }
    })();
  </script>
