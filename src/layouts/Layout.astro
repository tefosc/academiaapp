---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "AcademIA — Preparación examen de admisión UNC",
  description = "AcademIA: preparación para el examen de admisión a la UNC (Cajamarca). Exámenes reales, plan personalizado y tu afinidad por carrera en tiempo real.",
  image = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const siteUrl = Astro.site!.toString().replace(/\/$/, "");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "AcademIA",
      url: siteUrl,
      logo: `${siteUrl}/academia-logo.svg`,
      email: "noreply@academiaapp.online",
      description:
        "AcademIA prepara a postulantes para el examen de admisión de la Universidad Nacional de Cajamarca (UNC) con simulacros reales y práctica adaptada a cada carrera.",
      areaServed: {
        "@type": "Place",
        name: "Cajamarca, Perú",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "AcademIA",
      inLanguage: "es-PE",
      publisher: { "@id": `${siteUrl}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#app`,
      name: "AcademIA",
      applicationCategory: "EducationalApplication",
      operatingSystem: "Android, iOS",
      inLanguage: "es-PE",
      description:
        "App de preparación para el examen de admisión a la UNC. Mide tu afinidad por cada carrera mientras practicas y te dice qué estudiar cada día.",
      publisher: { "@id": `${siteUrl}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Marca <html class="js"> solo si las animaciones de entrada pueden correr.
         Sin esto (sin JS, sin IntersectionObserver o con movimiento reducido) todo el contenido queda visible. -->
    <script is:inline>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/academia-favicon.svg" />

    <!-- Tipografías propias (public/fonts): sin hojas de estilo ni orígenes externos que bloqueen el render -->
    <link rel="preload" href="/fonts/space-grotesk-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AcademIA" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="AcademIA — preparación para el examen de admisión UNC"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
