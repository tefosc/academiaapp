  .top-navy { background: var(--navy); color: #fff; text-align: center; padding: 50px 0 13px; font-size: 14px; font-weight: 700; }
  .back-bar {
    margin-top: auto;
    background: var(--screen-bg);
    border-top: 1px solid #ece9df;
    text-align: center;
    padding: 12px 0 16px;
    font-size: 12.5px;
    font-weight: 800;
    color: var(--navy);
  }

  /* ---------- HOME ---------- */
