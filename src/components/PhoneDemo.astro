<style>
  /* Tokens reales de la app — scoped al componente, no tocan la landing */
  .phone-demo {
    --navy: #1e3a8a;
    --gold: #f5a623;
    --teal: #0f9d8c;
    --green: #1ea24a;
    --green-deep: #178f3f;
    --red: #ef4444;
    --screen-bg: #f8f7f0;
    --muted: #6b7280;
    --border: #e7e4da;
    --shadow: rgba(0, 0, 0, 0.55);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .phone-demo svg { stroke-linecap: round; stroke-linejoin: round; }
  .phone-demo button { font-family: inherit; cursor: default; }

  .phone-wrap { position: relative; display: flex; justify-content: center; }

  .phone {
    position: relative;
    width: min(312px, 78vw);
    aspect-ratio: 9/19.4;
    background: #0b0c10;
    border-radius: 48px;
    padding: 12px;
    box-shadow: 0 40px 80px -24px var(--shadow), 0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    z-index: 2;
  }
  .notch {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 98px;
    height: 25px;
    background: #0b0c10;
    border-radius: 14px;
    z-index: 7;
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--screen-bg);
    border-radius: 36px;
    overflow: hidden;
  }
  .statusbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 44px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 24px 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--sb);
    z-index: 6;
    transition: color 0.35s ease;
    pointer-events: none;
  }
  .statusbar svg { display: block; }

  /* Paneles */
  .panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    display: flex;
    flex-direction: column;
  }
  .panel.active { opacity: 1; transform: translateY(0) scale(1); }

  /* Entradas escalonadas */
  .s { opacity: 0; }
  .panel.active .s { animation: rise 0.55s cubic-bezier(0.22, 0.7, 0.3, 1) both; }
  .panel.active .s1 { animation-delay: 0.05s; } .panel.active .s2 { animation-delay: 0.12s; }
  .panel.active .s3 { animation-delay: 0.19s; } .panel.active .s4 { animation-delay: 0.26s; }
  .panel.active .s5 { animation-delay: 0.33s; } .panel.active .s6 { animation-delay: 0.40s; }
  .panel.active .s7 { animation-delay: 0.47s; } .panel.active .s8 { animation-delay: 0.54s; }
  .panel.active .s9 { animation-delay: 0.61s; }
  @keyframes rise { from { opacity: 0; transform: translateY(9px); } to { opacity: 1; transform: none; } }

  /* Barra de navegación inferior (compartida) */
  .navbar {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    padding: 9px 4px 16px;
    background: #fff;
    border-top: 1px solid var(--border);
  }
  .nav-item { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 8.5px; color: #8a8f9b; font-weight: 600; }
  .nav-item svg { stroke: #8a8f9b; stroke-width: 1.8; }
