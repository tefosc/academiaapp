          <div class="q-math s s4">
            <svg viewBox="0 0 268 47" role="img" aria-label="Calcular: A igual a la raíz anidada de 5 operador raíz de 5 operador raíz de 5, si a operador b es igual a a menos 4 b al cuadrado">
              <g font-family="Georgia,'Times New Roman',serif" font-size="13" fill="#12161f">
                <text x="0" y="21">Calcular:</text>
                <text x="56" y="21" font-style="italic">A</text>
                <text x="68" y="21">=</text>
                <text x="94" y="21">5 ⊛</text>
                <text x="130" y="21">5 ⊛</text>
                <text x="166" y="21">5 ⊛ ⋯</text>
                <text x="208" y="21">Si: <tspan font-style="italic">a</tspan> ⊛ <tspan font-style="italic">b</tspan> =</text>
                <text x="0" y="42"><tspan font-style="italic">a</tspan> − 4<tspan font-style="italic">b</tspan><tspan dy="-4.5" font-size="9">2</tspan></text>
              </g>
              <g stroke="#12161f" stroke-width="1.15" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M80 16.5 l2 -1.2 l3.1 7.2 L89.6 4 H202"></path>
                <path d="M116 17 l2 -1.2 l3 6.7 L125.4 7 H199.5"></path>
                <path d="M152 17.5 l1.9 -1.2 l2.8 6.2 L161 10 H197"></path>
              </g>
            </svg>
