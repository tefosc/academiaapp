<script>
  const rootEl = document.getElementById("phone-demo");
  if (rootEl) initPhoneDemo(rootEl);

  function initPhoneDemo(root: HTMLElement) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const phases = [
      { id: "home",     dur: 5000, cap: "Tu afinidad, en vivo",       sb: "#FFFFFF" },
      { id: "practica", dur: 4000, cap: "Práctica adaptativa",        sb: "#FFFFFF" },
      { id: "question", dur: 4600, cap: "Simulacro real UNC",         sb: "#15181F" },
      { id: "results",  dur: 4200, cap: "Resultados al instante",     sb: "#FFFFFF" },
      { id: "plan",     dur: 4400, cap: "Plan de estudio con IA",     sb: "#FFFFFF" },
      { id: "progreso", dur: 4400, cap: "Radar de dominio Markov",    sb: "#FFFFFF" },
      { id: "quiz",     dur: 3600, cap: "Test vocacional adaptativo", sb: "#FFFFFF" },
      { id: "match",    dur: 4800, cap: "Tu carrera ideal",           sb: "#FFFFFF" },
    ];

    const $ = (sel: string) => root.querySelector<HTMLElement>(sel);
    const screen = $("#pd-screen")!;
    const capEl = $("#pd-cap")!;
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".dot-i"));

    function ease(t: number) { return 1 - Math.pow(1 - t, 3); }
    function animateNumber(el: HTMLElement, from: number, to: number, dur: number, onDone?: () => void) {
      let start: number | null = null;
      function step(ts: number) {
        if (!start) start = ts;
        const p = Math.min((ts - start) / dur, 1);
        el.textContent = String(Math.round(from + (to - from) * ease(p)));
        if (p < 1) requestAnimationFrame(step);
        else if (onDone) onDone();
      }
      requestAnimationFrame(step);
    }

    /* ---- animaciones por pantalla ---- */
    const C = 2 * Math.PI * 52; // 326.73
    function animHome() {
      const ring = $("#ring-progress")!;
      const num = $("#ring-num")!;
      ring.style.transition = "none";
      ring.style.strokeDashoffset = String(C);
      num.textContent = "0";
      requestAnimationFrame(() => requestAnimationFrame(() => {
        ring.style.transition = "stroke-dashoffset 1.15s cubic-bezier(.2,.7,.3,1)";
        ring.style.strokeDashoffset = String(C * (1 - 0.71));
        animateNumber(num, 0, 71, 1150);
      }));
    }

    let qInterval: ReturnType<typeof setInterval> | null = null;
    let qSecs = 0;
    const fmt = (n: number) => (n < 10 ? "0" + n : "" + n);
    function animQuestion() {
      const opt = $("#opt-e")!;
      const next = $("#next-btn")!;
      const timer = $("#q-timer")!;
      opt.classList.remove("picked");
      next.classList.remove("pulse");
      qSecs = 2 * 3600 + 55 * 60 + 23;
      timer.textContent = "02:55:23";
      qInterval = setInterval(() => {
        qSecs--;
        const h = Math.floor(qSecs / 3600), m = Math.floor((qSecs % 3600) / 60), s = qSecs % 60;
        timer.textContent = fmt(h) + ":" + fmt(m) + ":" + fmt(s);
      }, 1000);
      setTimeout(() => opt.classList.add("picked"), 900);
      setTimeout(() => next.classList.add("pulse"), 2300);
    }

    function animResults() {
      const num = $("#res-num")!;
      const up = $("#res-up")!;
      up.classList.remove("show");
      num.textContent = "0";
      setTimeout(() => {
        animateNumber(num, 0, 418, 950, () => {
          setTimeout(() => up.classList.add("show"), 120);
        });
      }, 300);
    }

    function animQuiz() {
      const o = $("#qopt-math")!;
      o.classList.remove("picked");
      setTimeout(() => o.classList.add("picked"), 1500);
    }

    function animMatch() {
      const segs = root.querySelectorAll("#seg-row .seg");
      const num = $("#match-num")!;
      segs.forEach((s) => s.classList.remove("on"));
      num.textContent = "0";
      segs.forEach((s, i) => {
        setTimeout(() => s.classList.add("on"), 400 + i * 85);
      });
      setTimeout(() => animateNumber(num, 0, 100, 850), 450);
    }

    function setStatic() {
      // estado final para prefers-reduced-motion
      $("#ring-progress")!.style.strokeDashoffset = String(C * (1 - 0.71));
      $("#ring-num")!.textContent = "71";
      $("#res-num")!.textContent = "418";
      $("#res-up")!.classList.add("show");
      $("#match-num")!.textContent = "100";
      root.querySelectorAll("#seg-row .seg").forEach((s) => s.classList.add("on"));
      $("#opt-e")!.classList.add("picked");
      $("#qopt-math")!.classList.add("picked");
    }

    /* ---- bucle + navegación manual ---- */
    let idx = 0;
    let timeoutId: ReturnType<typeof setTimeout> | null = null;
    let endAt = 0, remaining = 0, paused = false;

    function activate(i: number) {
      idx = i;
      const p = phases[i];
      if (qInterval) { clearInterval(qInterval); qInterval = null; }
      root.querySelectorAll(".panel").forEach((el) => el.classList.remove("active"));
      $("#panel-" + p.id)!.classList.add("active");
      screen.style.setProperty("--sb", p.sb);
      capEl.textContent = p.cap;
      dots.forEach((d, di) => d.classList.toggle("on", di === i));
      if (reduced) return;
      capEl.classList.remove("swap");
      void capEl.offsetWidth;
      capEl.classList.add("swap");
      if (p.id === "home") animHome();
      if (p.id === "question") animQuestion();
      if (p.id === "results") animResults();
      if (p.id === "quiz") animQuiz();
      if (p.id === "match") animMatch();
    }

    function schedule(ms: number) {
      if (reduced) return;
      endAt = Date.now() + ms;
      timeoutId = setTimeout(next, ms);
    }
    function next() {
      goTo((idx + 1) % phases.length);
    }
    function goTo(i: number) {
      if (timeoutId) clearTimeout(timeoutId);
      activate(i);
      if (paused) {
        remaining = phases[i].dur;
      } else {
        schedule(phases[i].dur);
      }
    }

    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
    $("#pd-prev")?.addEventListener("click", () => goTo((idx - 1 + phases.length) % phases.length));
    $("#pd-next")?.addEventListener("click", () => goTo((idx + 1) % phases.length));

    if (reduced) {
      setStatic();
      activate(0); // Home estático; la navegación manual sigue funcionando
      return;
    }

    /* pausa al pasar el mouse sobre el teléfono */
    const wrap = $("#pd-wrap")!;
    wrap.addEventListener("mouseenter", () => {
      if (paused) return;
      paused = true;
      remaining = Math.max(endAt - Date.now(), 400);
      if (timeoutId) clearTimeout(timeoutId);
    });
    wrap.addEventListener("mouseleave", () => {
      if (!paused) return;
      paused = false;
      schedule(remaining);
    });

    activate(0);
    schedule(phases[0].dur);
  }
</script>
